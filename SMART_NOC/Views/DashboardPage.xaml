<Page
    x:Class="SMART_NOC.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="#000D15"
    RequestedTheme="Dark">

    <Grid Padding="24" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Dashboard - History TT"
                   FontSize="24"
                   FontWeight="Bold"
                   Foreground="White"
                   FontFamily="{StaticResource InterBold}"/>

        <TextBlock Grid.Row="1"
                   Text="Halaman ini menampilkan TT yang sudah tercatat dari form Create TT."
                   Foreground="#B6C3D1"
                   FontSize="13"/>

        <Border Grid.Row="2" Background="#0D1B2A" BorderBrush="#1E3A52" BorderThickness="1" CornerRadius="12" Padding="8">
            <ListView x:Name="HistoryListView" SelectionMode="None">
                <ListView.Header>
                    <Grid Padding="10,8" Background="#16293A" CornerRadius="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="280"/>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="120"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Title" Foreground="#DDE8F2" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="1" Text="Occur Time" Foreground="#DDE8F2" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="2" Text="Dispacth Time" Foreground="#DDE8F2" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="3" Text="PIC" Foreground="#DDE8F2" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="4" Text="Rootcause" Foreground="#DDE8F2" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="5" Text="Cut Point" Foreground="#DDE8F2" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="6" Text="Created" Foreground="#DDE8F2" FontWeight="SemiBold"/>
                    </Grid>
                </ListView.Header>

                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="10,8" BorderBrush="#123145" BorderThickness="0,0,0,1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="280"/>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="120"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="{Binding Title}" Foreground="White" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Grid.Column="1" Text="{Binding OccurTime}" Foreground="#C7D4E0"/>
                            <TextBlock Grid.Column="2" Text="{Binding DispatchTime}" Foreground="#C7D4E0"/>
                            <TextBlock Grid.Column="3" Text="{Binding Pic}" Foreground="#C7D4E0" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Grid.Column="4" Text="{Binding RootCause}" Foreground="#C7D4E0" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Grid.Column="5" Text="{Binding CutPoint}" Foreground="#C7D4E0" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Grid.Column="6" Text="{Binding CreatedAtDisplay}" Foreground="#8FB5D6"/>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>
    </Grid>
</Page>

